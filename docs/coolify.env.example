# Paste into Coolify application Environment Variables; enable Runtime, disable Build time.
# Replace every REPLACE_* value. Do not commit real secrets.
APP_ENV=production
HOST=0.0.0.0
PORT=8000
APP_RELOAD=false
USE_POLLING=false
AUTO_MIGRATE=true
DATABASE_URL=REPLACE_WITH_POSTGRES_CONNECTION_URL
DB_POOL_SIZE=10
DB_STATEMENT_CACHE_SIZE=100
BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
WEBHOOK_BASE_URL=https://REPLACE_WITH_YOUR_DOMAIN
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_AT_LEAST_12_CHARACTERS
# Keep the EXISTING persistent SECRET_KEY when using an existing database.
SECRET_KEY=REPLACE_WITH_EXISTING_SECRET_KEY_OR_NEW_64_HEX_CHARACTERS
# Optional: your numeric Telegram user ID. Saved console administrator IDs take precedence.
ADMIN_TG_ID=0
# Typical Docker subnet. Replace/add the actual Coolify proxy subnet if different.
TRUSTED_PROXY_IPS=127.0.0.1,::1,172.16.0.0/12
# WEBHOOK_SECRET is derived from SECRET_KEY if omitted.
# ALLOWED_HOSTS / ALLOWED_ORIGINS are derived from WEBHOOK_BASE_URL if omitted.
# COOKIE_SECURE is enabled automatically by APP_ENV=production.
# REDIS_URL is optional; conversation state is stored in PostgreSQL without Redis.
